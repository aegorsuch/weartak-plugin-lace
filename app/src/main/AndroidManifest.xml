<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.weartak.plugin.permission.BIND_PLUGIN"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/lace_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lace">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.weartak.plugin.lace.LaceActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.weartak.plugin.lace.host.LacePluginService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.weartak.plugin.MENU_SUBTITLE"
                android:value="Unfunded Request" />
        </service>
    </application>
</manifest>